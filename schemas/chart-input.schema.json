{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiuYaoChartInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "lines"],
  "properties": {
    "question": {"type": "string", "maxLength": 500},
    "categoryId": {"type": "string"},
    "manualRelative": {"type": "string", "enum": ["", "父母", "官鬼", "妻財", "兄弟", "子孫"]},
    "date": {"type": "string", "format": "date", "pattern": "^(19[0-9]{2}|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"},
    "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": "12:00"},
    "dayGanzhi": {"type": "string", "maxLength": 2},
    "monthBranch": {"type": "string", "enum": ["", "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"]},
    "lines": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "integer", "enum": [6, 7, 8, 9]},
      "description": "由初爻到上爻；6老陰、7少陽、8少陰、9老陽"
    }
  }
}
