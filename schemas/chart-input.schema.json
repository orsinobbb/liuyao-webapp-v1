{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiuYaoChartInput",
  "type": "object",
  "required": [
    "lines"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "dateTime": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "integer",
        "enum": [
          6,
          7,
          8,
          9
        ]
      },
      "description": "由初爻到上爻；6老陰、7少陽、8少陰、9老陽"
    }
  }
}
